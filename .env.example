# --------------------------------------------------------------------------
# Gabriel environment configuration
# Copy this file to .env and adjust the values for your environment.
# --------------------------------------------------------------------------

# PostgreSQL + pgvector connection string. This single database stores ALL
# state: sessions, chat history, agents, per-agent tool state, the crawler
# link queue, LangGraph checkpoints, and the vector knowledge base.
#
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://gabriel:gabriel@localhost:5432/gabriel

# Dimensionality of the vectors stored in the `documents.embedding` column.
# This MUST match the embedding model you use. The default model `bge-m3`
# produces 1024-dimensional vectors. If you change the model, update this
# value AND re-run `python -m db.migrate` against a fresh database.
EMBEDDING_DIM=1024

# --------------------------------------------------------------------------
# Ollama is used as an external embedding/LLM service. It is NOT a storage
# backend — vectors produced by Ollama are persisted in PostgreSQL/pgvector.
# --------------------------------------------------------------------------

# Base URL of the Ollama server used for embeddings (and chat models).
OLLAMA_BASE_URL=http://localhost:11434

# Embedding model served by Ollama. Must produce vectors of size EMBEDDING_DIM.
EMBEDDING_MODEL=bge-m3